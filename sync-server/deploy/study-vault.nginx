server {
    listen 9443 ssl;
    server_name 187.127.69.22;

    ssl_certificate /opt/study-vault/tls/config/live/study-vault-ip/fullchain.pem;
    ssl_certificate_key /opt/study-vault/tls/config/live/study-vault-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:StudyVaultSSL:10m;
    ssl_session_tickets off;

    client_max_body_size 256m;
    client_body_timeout 60s;
    add_header Strict-Transport-Security "max-age=15552000" always;
    access_log /var/log/nginx/study-vault.access.log;
    error_log /var/log/nginx/study-vault.error.log;

    location / {
        proxy_pass http://127.0.0.1:9080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
